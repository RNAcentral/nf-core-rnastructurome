// conf/bacterial_genomes.config
//
// Curated NCBI accession lists for bacterial organisms.  Loaded automatically
// by nextflow.config — no user action required.
//
// Keying rules: lowercase organism string from the samplesheet, with any run
// of non-alphanumeric characters replaced by a single underscore.
// e.g. "Escherichia coli" → "escherichia_coli"
//
// Bacteria are not served by main Ensembl and the EnsemblBacteria collections
// contain hundreds of strain-specific entries with no canonical representative.
// Pinning explicit RefSeq accessions here ensures reproducible, strain-matched
// alignment and bypasses the NCBI auto-search entirely.

params {
    ncbi_accessions_map = [

        // ── Escherichia coli ─────────────────────────────────────────────────
        // K-12 MG1655 — the standard lab reference strain; complete chromosome.
        // Use this for any E. coli experiment where the strain is unknown or
        // known to be a K-12 derivative.
        'escherichia_coli': [
            'NC_000913.3',
        ],

    ]
}
