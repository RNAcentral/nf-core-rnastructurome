/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EBI Codon SLURM profile overrides
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Keep Codon-specific resource tuning here so generic container and module defaults
    remain portable for other clusters.
----------------------------------------------------------------------------------------
*/

process {
    // FASTQC: uses ~2 threads (JVM multi-thread overhead); keep memory high for JVM heap
    withName: 'FASTQC_PRE|FASTQC_POST' {
        cpus   = 2
        memory = { 36.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'UMITOOLS_DEDUP' {
        cpus   = 1
        memory = { 48.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withName: BOWTIE_ALIGN {
        cpus       = 24
        memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
        time       = { 16.h * task.attempt }
        maxRetries = 2
    }

    withName: BOWTIE2_ALIGN {
        cpus       = 24
        memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
        time       = { 16.h * task.attempt }
        maxRetries = 2
    }

    // STAR: ~11 CPUs, ~43 GB RSS observed
    withName: 'STAR_ALIGN_MAP|STAR_ALIGN_RTSTOP' {
        cpus   = 12
        memory = { 48.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // SAMTOOLS_SORT_NAME / coordinate SORT: ~4 CPUs, ~5 GB RSS observed
    withName: 'SAMTOOLS_SORT_NAME|SAMTOOLS_SORT' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // SAMTOOLS_MARKDUP: ~2 CPUs but up to 131 GB RSS observed — increase base memory
    withName: SAMTOOLS_MARKDUP {
        cpus       = 4
        memory     = { 160.GB * task.attempt }
        maxRetries = 2
    }

    withName: 'RNAFRAMEWORK_RFCOUNT_GENOME' {
        cpus   = 12
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'RNAFRAMEWORK_RFCOUNT' {
        cpus   = 60
        memory = { 72.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    // RFNORM: ~55 CPUs (-p task.cpus), ~21 GB RSS observed
    withName: 'RNAFRAMEWORK_RFNORM' {
        cpus       = 60
        memory     = { 32.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        maxRetries = 2
    }

    // RFFOLD: ~51 CPUs (-p task.cpus), ~3.7 GB RSS observed (vmem is high due to ViennaRNA)
    withName: 'RNAFRAMEWORK_RFFOLD' {
        cpus   = 60
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'MERGE_BP' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'MERGE_BP_TRANSCRIPT' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'AVERAGE_WIG' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'MULTIQC' {
        memory     = { 32.GB * task.attempt }
        time       = { 8.h  * task.attempt }
        maxRetries = 2
    }

    withName: 'R2DT' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'VIENNARNA' {
        cpus = 12
    }
}
