/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EBI Codon SLURM profile overrides
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Keep Codon-specific resource tuning here so generic container and module defaults
    remain portable for other clusters.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'FASTQC_PRE|FASTQC_POST' {
        cpus   = 6
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'UMITOOLS_DEDUP' {
        cpus   = 1
        memory = { 48.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withName: BOWTIE_ALIGN {
        cpus       = 24
        memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
        time       = { 16.h * task.attempt }
        maxRetries = 2
    }

    withName: BOWTIE2_ALIGN {
        cpus       = 24
        memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
        time       = { 16.h * task.attempt }
        maxRetries = 2
    }

    withName: SAMTOOLS_MARKDUP {
        cpus       = 12
        memory = { 96.GB * task.attempt }
        maxRetries = 2
    }

    withName: 'RNAFRAMEWORK_RFCOUNT_GENOME' {
        cpus = 16
    }

    withName: 'RNAFRAMEWORK_RFCOUNT' {
        cpus   = 16
        memory = { 72.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withName: 'RNAFRAMEWORK_RFNORM' {
        cpus       = 16
        memory     = { 96.GB * task.attempt }
        time       = { 24.h * task.attempt }
        maxRetries = 2
    }

    withName: 'RNAFRAMEWORK_RFFOLD' {
        cpus   = 16
        memory = { 72.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withName: 'MERGE_BP' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'MERGE_BP_TRANSCRIPT' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'AVERAGE_WIG' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'MULTIQC' {
        memory     = { 32.GB * task.attempt }
        time       = { 8.h  * task.attempt }
        maxRetries = 2
    }

    withName: 'R2DT' {
        memory = { 64.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'VIENNARNA' {
        cpus = 12
    }
}
