/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: CUTADAPT_RTSTOP {
        ext.args = {
            def default_adapter = 'AGATCGGAAGAGC'
            def adapter_5p = meta.adapter_5p ?: params.cutadapt_adapter_5p ?: default_adapter
            def adapter_3p = meta.adapter_3p ?: params.cutadapt_adapter_3p ?: default_adapter
            def quality_only = params.cutadapt_quality_only ?: false
            def q3 = params.cutadapt_3quality != null ? params.cutadapt_3quality as Integer : 20
            def min_len = params.cutadapt_len != null ? params.cutadapt_len as Integer : 25
            def min_align = params.cutadapt_min_align != null ? params.cutadapt_min_align as Integer : 1
            def trim_n = params.cutadapt_trim_n == null ? true : params.cutadapt_trim_n as Boolean
            def base_complement = ['A':'T', 'C':'G', 'G':'C', 'T':'A', 'N':'N']
            def args = []
            if (!quality_only) {
                (adapter_5p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    def revcomp_seq = seq.toUpperCase().reverse().collect { nt -> base_complement[nt] ?: 'N' }.join('')
                    args << "-g ${revcomp_seq}"
                    if (!meta.single_end) {
                        args << "-G ${revcomp_seq}"
                    }
                }
                (adapter_3p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    args << "-a ${seq}"
                    if (!meta.single_end) {
                        args << "-A ${seq}"
                    }
                }
            }
            def pair_filter = meta.single_end ? '' : '--pair-filter=any'
            def trim_n_arg = trim_n ? '--trim-n' : ''
            "${args.join(' ')} -q 0,${q3} -m ${min_len} ${trim_n_arg} -O ${min_align} ${pair_filter}".trim()
        }
    }

    withName: CUTADAPT_MAP {
        ext.args = {
            def default_adapter = 'AGATCGGAAGAGC'
            def adapter_5p = meta.adapter_5p ?: params.cutadapt_adapter_5p ?: default_adapter
            def adapter_3p = meta.adapter_3p ?: params.cutadapt_adapter_3p ?: default_adapter
            def quality_only = params.cutadapt_quality_only ?: false
            def q5 = params.cutadapt_5quality != null ? params.cutadapt_5quality as Integer : 20
            def q3 = params.cutadapt_3quality != null ? params.cutadapt_3quality as Integer : 20
            def min_len = params.cutadapt_len != null ? params.cutadapt_len as Integer : 25
            def min_align = params.cutadapt_min_align != null ? params.cutadapt_min_align as Integer : 1
            def trim_n = params.cutadapt_trim_n == null ? true : params.cutadapt_trim_n as Boolean
            def base_complement = ['A':'T', 'C':'G', 'G':'C', 'T':'A', 'N':'N']
            def args = []
            if (!quality_only) {
                (adapter_5p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    def revcomp_seq = seq.toUpperCase().reverse().collect { nt -> base_complement[nt] ?: 'N' }.join('')
                    args << "-g ${revcomp_seq}"
                    if (!meta.single_end) {
                        args << "-G ${revcomp_seq}"
                    }
                }
                (adapter_3p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    args << "-a ${seq}"
                    if (!meta.single_end) {
                        args << "-A ${seq}"
                    }
                }
            }
            def pair_filter = meta.single_end ? '' : '--pair-filter=any'
            def trim_n_arg = trim_n ? '--trim-n' : ''
            "${args.join(' ')} -q ${q5},${q3} -m ${min_len} ${trim_n_arg} -O ${min_align} ${pair_filter}".trim()
        }
    }

    withName: UMITOOLS_EXTRACT {
        ext.when = { (meta.umi_pattern ?: '').toString().trim() ? true : false }
        ext.args = {
            def umi_pattern = (meta.umi_pattern ?: params.umi_pattern ?: '').toString().trim().toUpperCase()
            def iupac_map = [
                'A':'A', 'C':'C', 'G':'G', 'T':'T', 'R':'[AG]', 'Y':'[CT]', 'S':'[GC]',
                'W':'[AT]', 'K':'[GT]', 'M':'[AC]', 'B':'[CGT]', 'D':'[AGT]', 'H':'[ACT]',
                'V':'[ACG]', 'N':'[ACGT]', 'X':'[ACGT]'
            ]
            if (!umi_pattern) {
                return ''
            }
            if (umi_pattern ==~ /[NCX]+/) {
                return "--bc-pattern=${umi_pattern}"
            }
            def invalid_chars = umi_pattern.collect { nt -> nt as String }.findAll { nt -> !iupac_map.containsKey(nt) }.unique()
            if (invalid_chars) {
                error("Unsupported umi_pattern '${umi_pattern}' for sample '${meta.id}'. Unsupported character(s): ${invalid_chars.join(', ')}")
            }
            def regex_pattern = umi_pattern.collect { nt -> iupac_map[nt as String] }.join('')
            "--extract-method=regex --bc-pattern=\"^(?P<umi_1>${regex_pattern})\""
        }
    }

    withName: BOWTIE_ALIGN {
        ext.args = {
            def manual_only = params.bowtie_manual_only as Boolean ?: false
            def manual_params = (params.bowtie_mapping_params ?: '').toString().trim()
            if (manual_only) {
                return manual_params
            }
            def args = []
            if (params.bowtie_all as Boolean) {
                args << '-a'
            } else if (params.bowtie_k != null) {
                args << "-k ${params.bowtie_k as Integer}"
            }
            if (params.bowtie_norc as Boolean) {
                args << '--norc'
            }
            if ((params.bowtie_trim5 as Integer) > 0) {
                args << "--trim5 ${params.bowtie_trim5 as Integer}"
            }
            if ((params.bowtie_trim3 as Integer) > 0) {
                args << "--trim3 ${params.bowtie_trim3 as Integer}"
            }
            def seedlen = params.bowtie_seedlen != null ? params.bowtie_seedlen as Integer : 28
            args << "-l ${seedlen}"
            if (params.bowtie_v != null) {
                args << "-v ${params.bowtie_v as Integer}"
            } else {
                args << "-n ${params.bowtie_n as Integer}"
            }
            if (!(params.bowtie_all as Boolean) && params.bowtie_k == null && params.bowtie_max != null) {
                args << "-m ${params.bowtie_max as Integer}"
            }
            args << "--chunkmbs ${params.bowtie_chunkmbs as Integer}"
            if (manual_params) {
                args << manual_params
            }
            args.join(' ').trim()
        }
    }

    withName: BOWTIE2_ALIGN {
        ext.args = {
            def manual_only = params.bowtie_manual_only as Boolean ?: false
            def manual_params = (params.bowtie_mapping_params ?: '').toString().trim()
            if (manual_only) {
                return manual_params
            }
            def args = []
            if (params.bowtie_all as Boolean) {
                args << '-a'
            } else if (params.bowtie_k != null) {
                args << "-k ${params.bowtie_k as Integer}"
            }
            if (params.bowtie_norc as Boolean) {
                args << '--norc'
            }
            if ((params.bowtie_trim5 as Integer) > 0) {
                args << "--trim5 ${params.bowtie_trim5 as Integer}"
            }
            if ((params.bowtie_trim3 as Integer) > 0) {
                args << "--trim3 ${params.bowtie_trim3 as Integer}"
            }
            def seedlen = params.bowtie_seedlen != null ? params.bowtie_seedlen as Integer : 22
            args << "-L ${seedlen}"
            args << "-N ${params.bowtie2_N as Integer}"
            args << "-D ${params.bowtie2_D as Integer}"
            args << "-R ${params.bowtie2_R as Integer}"
            args << "--mp ${params.bowtie2_mp}"
            args << "--dpad ${params.bowtie2_dpad as Integer}"
            args << "--rdg ${params.bowtie2_rdg}"
            args << "--rfg ${params.bowtie2_rfg}"
            if (params.bowtie2_softclip as Boolean) {
                args << '--local'
                args << "--ma ${params.bowtie2_ma as Integer}"
            }
            if (params.bowtie2_dovetail as Boolean) {
                args << '--dovetail'
            }
            if (manual_params) {
                args << manual_params
            }
            args.join(' ').trim()
        }
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: SAMTOOLS_MARKDUP {
        ext.args = '-r'
    }

    withName: 'RNAFRAMEWORK_RFCOUNT' {
        container = params.rnaframework_container
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = ((System.properties['os.arch'] ?: '').toLowerCase() in ['aarch64', 'arm64'])
                return isArm64 ? '-u 1000:1000' : '--platform linux/amd64 -u 1000:1000'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // RT-stop: count RT-stops (default mode)
        // MaP:     count mutations (-m), with collapse and quality filters configurable via rfcount_map_* params
        ext.args   = {
            def is_map = (meta.principle ?: '').toLowerCase() == 'map'
            def args = []

            if (is_map) {
                args << '-m'
                if (params.rfcount_map_sort_by_read_name as Boolean) {
                    args << '--sort-by-read-name'
                }

                def discard_shorter = params.rfcount_map_discard_shorter != null ? params.rfcount_map_discard_shorter as Integer : 1
                if (discard_shorter > 1) {
                    args << "--discard-shorter ${discard_shorter}"
                }

                def min_quality = params.rfcount_map_min_quality != null ? params.rfcount_map_min_quality as Integer : 20
                if (min_quality != 20) {
                    args << "--min-quality ${min_quality}"
                }

                if (params.rfcount_map_collapse_consecutive as Boolean) {
                    args << '--collapse-consecutive'
                    def max_collapse_distance = params.rfcount_map_max_collapse_distance != null ? params.rfcount_map_max_collapse_distance as Integer : 2
                    if (max_collapse_distance != 2) {
                        args << "--max-collapse-distance ${max_collapse_distance}"
                    }
                }
            }
            // Always generate rf-count plots.
            args << '-g'
            args << "-R ${params.rnaframework_r_path}"
            def trim5 = params.rfcount_trim_5prime != null ? params.rfcount_trim_5prime as Integer : 0
            if (trim5 > 0) {
                args << "-t5 ${trim5}"
            }
            if (params.rfcount_mask_file) {
                args << "--mask-file \"${params.rfcount_mask_file}\""
            }
            if (params.rfcount_primary_only as Boolean) {
                args << '--primary-only'
            }

            // For paired-end data, default to properly paired reads unless a paired filter is explicitly set.
            def paired_filter_requested = (params.rfcount_paired_only as Boolean) || (params.rfcount_properly_paired as Boolean)
            if (!meta.single_end) {
                if (params.rfcount_paired_only as Boolean) {
                    args << '--paired-only'
                } else if ((params.rfcount_properly_paired as Boolean) || !paired_filter_requested) {
                    args << '--properly-paired'
                }
            }

            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/count" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                filename.replaceFirst(/_rfcount(?=\/|$)/, '')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFNORM' {
        cpus = 8
        container = params.rnaframework_container
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = ((System.properties['os.arch'] ?: '').toLowerCase() in ['aarch64', 'arm64'])
                return isArm64 ? '-u 1000:1000' : '--platform linux/amd64 -u 1000:1000'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // Dynamic rf-norm defaults derived from principle and available controls:
        // RT-stop + untreated: Ding (sm=1) with Box-plot normalisation (nm=3)
        // RT-stop only:        Rouskin (sm=2) with 90% Winsorizing   (nm=2)
        // MaP + untreated:     Siegfried (sm=3) with Box-plot normalisation (nm=3)
        // MaP treated only:    Zubradt (sm=4) with Box-plot normalisation   (nm=3)
        // Denatured is optional for Siegfried and passed automatically when present.
        ext.args   = {
            def args = [
                "-sm ${meta.rfnorm_scoring_method}",
                "-nm ${meta.rfnorm_norm_method}"
            ]
            if (params.rfnorm_remap_reactivities as Boolean) args << '--remap-reactivities'
            def reactiveBases = params.rfnorm_reactive_bases ?: (((meta.method ?: '').toLowerCase() == 'dms') ? ((meta.pH != null && (meta.pH as Double) >= 8.0) ? 'ACGU' : 'AC') : null)
            if (reactiveBases) args << "--reactive-bases ${reactiveBases}"
            if (params.rfnorm_norm_window != null) args << "--norm-window ${params.rfnorm_norm_window as Integer}"
            if (params.rfnorm_window_offset != null) args << "--window-offset ${params.rfnorm_window_offset as Integer}"
            if (params.rfnorm_dynamic_window != null) args << "--dynamic-window ${params.rfnorm_dynamic_window as Integer}"
            if (params.rfnorm_norm_independent as Boolean) args << '--norm-independent'
            if (params.rfnorm_norm_factor) args << "--norm-factor ${params.rfnorm_norm_factor}"
            if (params.rfnorm_raw as Boolean) args << '--raw'
            if (params.rfnorm_pseudocount != null) args << "--pseudocount ${params.rfnorm_pseudocount}"
            if (params.rfnorm_max_score != null) args << "--max-score ${params.rfnorm_max_score}"
            if (params.rfnorm_ignore_lower_than_untreated as Boolean) args << '--ignore-lower-than-untreated'
            if (params.rfnorm_max_untreated_mut != null) args << "--max-untreated-mut ${params.rfnorm_max_untreated_mut}"
            if (params.rfnorm_max_mutation_rate != null) args << "--max-mutation-rate ${params.rfnorm_max_mutation_rate}"
            def meanCoverage = params.rfnorm_mean_coverage != null ? params.rfnorm_mean_coverage as BigDecimal : 0
            if (meanCoverage > 0) args << "--mean-coverage ${params.rfnorm_mean_coverage}"
            def medianCoverage = params.rfnorm_median_coverage != null ? params.rfnorm_median_coverage as BigDecimal : 0
            if (medianCoverage > 0) args << "--median-coverage ${params.rfnorm_median_coverage}"
            def nanThreshold = params.rfnorm_nan != null ? params.rfnorm_nan as Integer : 10
            if (nanThreshold != 10) args << "--nan ${nanThreshold}"
            // Always generate rf-norm plots.
            args << '--img'
            args << "-R ${params.rnaframework_r_path}"
            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                filename.replaceFirst(/_norm(?=\/|$)/, '')
            }
        ]
    }

    withName: 'ENSEMBL_TRANSCRIPTOME' {
        publishDir = [
            path: {
                def ref_id = task.tag ? task.tag.tokenize(':')[0].replaceAll(/[^A-Za-z0-9._-]+/, '_') : 'ensembl'
                "${params.outdir}/reference/${ref_id}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.endsWith('.transcripts.fa.gz')) {
                    return null
                }
                filename
            }
        ]
    }

    withName: 'ENSEMBL_GTF' {
        publishDir = [
            path: {
                def ref_id = task.tag ? task.tag.tokenize(':')[0].replaceAll(/[^A-Za-z0-9._-]+/, '_') : 'ensembl'
                "${params.outdir}/reference/${ref_id}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.endsWith('.annotation.gtf.gz')) {
                    return null
                }
                filename
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFFOLD' {
        cpus = 16
        container = params.rnaframework_container
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = ((System.properties['os.arch'] ?: '').toLowerCase() in ['aarch64', 'arm64'])
                return isArm64 ? '-u 1000:1000' : '--platform linux/amd64 -u 1000:1000'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // Default behavior:
        // - dot-bracket output (rf-fold default; do not pass -ct unless explicitly requested)
        // - graphical structure reports always enabled via -g
        // - RNAplot SVG overlays configured by default via -vrp
        // - multiple XML inputs may be provided (e.g. biological replicates)
        ext.args   = {
            def args = []
            args << '-g'
            args << "-R ${params.rnaframework_r_path}"
            args << "-vrp ${params.rffold_vienna_rnaplot}"
            if (params.rffold_ct as Boolean) args << '-ct'
            if (params.rffold_window as Boolean) args << '-w'
            if (params.rffold_unconstrained as Boolean) args << '-i'
            if (params.rffold_vienna_no_lonely_pairs as Boolean) args << '-nlp'
            if (params.rffold_vienna_constrained as Boolean) args << '-hc'
            if (params.rffold_vienna_max_bp_span != null) args << "-md ${params.rffold_vienna_max_bp_span as Integer}"
            if (params.rffold_only_common != null) args << "-oc ${params.rffold_only_common as Integer}"
            if (params.rffold_fold_constraint_file) args << "-c ${params.rffold_fold_constraint_file}"
            if (params.rffold_dotplot as Boolean) args << '-dp'
            if (params.rffold_shannon_entropy as Boolean) args << '-sh'
            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                filename.replaceFirst(/_fold(?=\/|$)/, '')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_DOTPLOT2BP' {
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                filename
                    .replaceFirst(/_bp(?=\/|$)/, '')
                    .replaceFirst(/\/dotplot\//, '/bp/')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFWIGGLE' {
        container = params.rnaframework_container
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = ((System.properties['os.arch'] ?: '').toLowerCase() in ['aarch64', 'arm64'])
                return isArm64 ? '-u 1000:1000' : '--platform linux/amd64 -u 1000:1000'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                def f = filename.replaceFirst(/_norm(?=\/|$)/, '')
                def m = (f =~ /^(.+?)(?=_wiggle\/|\.merged\.wig$|_chrom\.sizes$)/)
                def sampleId = m ? m[0][1] : null
                sampleId ? "${sampleId}/${f}" : f
            }
        ]
    }

    withName: 'UCSC_WIGTOBIGWIG' {
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                def m = (filename =~ /^(.+)\.bw$/)
                def sampleId = m ? m[0][1] : null
                sampleId ? "${sampleId}/${filename}" : filename
            }
        ]
    }

    withName: 'RNAFRAMEWORK_TORDAT' {
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                filename.replaceFirst(/^(.+?)_rdat\//, '$1/rdat/')
            }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
