/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    def cutadaptArgsFor = { meta, is_rtstop ->
        def adapter_5p = meta.adapter_5p ?: params.cutadapt_adapter_5p
        def adapter_3p = meta.adapter_3p ?: params.cutadapt_adapter_3p
        def quality_only = params.cutadapt_quality_only ?: false
        def q5_default = params.cutadapt_5quality != null ? params.cutadapt_5quality as Integer : 20
        def q3_default = params.cutadapt_3quality != null ? params.cutadapt_3quality as Integer : 20
        def min_len = params.cutadapt_len != null ? params.cutadapt_len as Integer : 25
        def min_align = params.cutadapt_min_align != null ? params.cutadapt_min_align as Integer : 1
        def trim_n = params.cutadapt_trim_n == null ? true : params.cutadapt_trim_n as Boolean
        def q5 = is_rtstop ? 0 : q5_default
        def q3 = q3_default
        def base_complement = ['A':'T', 'C':'G', 'G':'C', 'T':'A', 'N':'N']
        def parseAdapters = { value ->
            (value ?: '')
                .toString()
                .tokenize(',')
                .collect { it.trim() }
                .findAll { it }
        }
        def reverse_complement = { seq ->
            seq
                .toUpperCase()
                .reverse()
                .collect { nt -> base_complement[nt] ?: 'N' }
                .join('')
        }

        def args = []
        if (!quality_only) {
            parseAdapters(adapter_5p).each { seq ->
                args << "-g ${reverse_complement(seq)}"
                if (!meta.single_end) {
                    args << "-G ${reverse_complement(seq)}"
                }
            }
            parseAdapters(adapter_3p).each { seq ->
                args << "-a ${seq}"
                if (!meta.single_end) {
                    args << "-A ${seq}"
                }
            }
        }

        def pair_filter = meta.single_end ? '' : '--pair-filter=any'
        def trim_n_arg = trim_n ? '--trim-n' : ''
        "${args.join(' ')} -q ${q5},${q3} -m ${min_len} ${trim_n_arg} -O ${min_align} ${pair_filter}".trim()
    }
    def umiExtractArgsFor = { meta ->
        def umi_pattern = (meta.umi_pattern ?: params.umi_pattern ?: '').toString().trim().toUpperCase()
        def iupac_map = [
            'A':'A',
            'C':'C',
            'G':'G',
            'T':'T',
            'R':'[AG]',
            'Y':'[CT]',
            'S':'[GC]',
            'W':'[AT]',
            'K':'[GT]',
            'M':'[AC]',
            'B':'[CGT]',
            'D':'[AGT]',
            'H':'[ACT]',
            'V':'[ACG]',
            'N':'[ACGT]',
            'X':'[ACGT]'
        ]

        if (!umi_pattern) {
            return ''
        }

        // Keep umi_tools string mode for canonical patterns.
        if (umi_pattern ==~ /[NCX]+/) {
            return "--bc-pattern=${umi_pattern}"
        }

        def invalid_chars = umi_pattern
            .collect { it as String }
            .findAll { nt -> !iupac_map.containsKey(nt) }
            .unique()
        if (invalid_chars) {
            error("Unsupported umi_pattern '${umi_pattern}' for sample '${meta.id}'. Unsupported character(s): ${invalid_chars.join(', ')}")
        }

        // Use regex mode to support IUPAC degenerate bases (e.g. D=A/G/T).
        def regex_pattern = umi_pattern.collect { nt -> iupac_map[nt as String] }.join('')
        "--extract-method=regex --bc-pattern=\"^(?P<umi_1>${regex_pattern})\""
    }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: CUTADAPT_RTSTOP {
        ext.args = { cutadaptArgsFor(meta, true) }
    }

    withName: CUTADAPT_MAP {
        ext.args = { cutadaptArgsFor(meta, false) }
    }

    withName: UMITOOLS_EXTRACT {
        ext.when = { (meta.umi_pattern ?: '').toString().trim() ? true : false }
        ext.args = { umiExtractArgsFor(meta) }
    }

    withName: BOWTIE_ALIGN {
        ext.args = '--best --strata'
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
