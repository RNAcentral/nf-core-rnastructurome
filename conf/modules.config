/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    def cutadaptArgsFor = { meta, q5, q3 ->
        def adapter_5p = params.cutadapt_adapter_5p ?: params.cutadapt_adapter_r1 ?: 'CAAGTCTCAAGATGTCAGGCTGCTAG'
        def adapter_3p = params.cutadapt_adapter_3p ?: params.cutadapt_adapter_r2 ?: 'AGATCGGAAGAGCACACGTCT'
        def quality_only = params.cutadapt_quality_only ?: false
        def base_complement = ['A':'T', 'C':'G', 'G':'C', 'T':'A', 'N':'N']
        def reverse_complement = { seq ->
            seq
                .toUpperCase()
                .reverse()
                .collect { nt -> base_complement[nt] ?: 'N' }
                .join('')
        }

        def args = []
        if (!quality_only) {
            adapter_5p.tokenize(',').collect { it.trim() }.findAll { it }.each { seq ->
                args << "-g ${reverse_complement(seq)}"
                if (!meta.single_end) {
                    args << "-G ${reverse_complement(seq)}"
                }
            }
            adapter_3p.tokenize(',').collect { it.trim() }.findAll { it }.each { seq ->
                args << "-a ${seq}"
                if (!meta.single_end) {
                    args << "-A ${seq}"
                }
            }
        }

        def pair_filter = meta.single_end ? '' : '--pair-filter=any'
        "${args.join(' ')} -q ${q5},${q3} -m 25 --trim-n -O 1 ${pair_filter}".trim()
    }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: CUTADAPT_RTSTOP {
        ext.args = { cutadaptArgsFor(meta, 0, 20) }
    }

    withName: CUTADAPT_MAP {
        ext.args = { cutadaptArgsFor(meta, 20, 20) }
    }

    withName: BOWTIE_ALIGN {
        ext.args = '--best --strata'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
