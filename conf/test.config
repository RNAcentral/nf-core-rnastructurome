/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

def testDataDir = new File(projectDir.toString(), 'tests/data')
def testSamplesheetSource = new File(testDataDir, 'rnastruct00001_samplesheet.first2.trim_subset_top3.csv')
def testSamplesheet = File.createTempFile('rnastructurome-test-', '.csv')
testSamplesheet.deleteOnExit()
testSamplesheet.text = testSamplesheetSource.text.replace('tests/data/', "${testDataDir.absolutePath}/")

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Human subset test dataset to check pipeline function'

    // Input
    input        = testSamplesheet.absolutePath
    principle    = 'RT-stop'
    fasta        = "${projectDir}/tests/data/Homo_sapiens.GRCh38.selected_top3_subset.fa"
    rfnorm_raw   = true // removed normalisation to obtain results in rfnorma dn rffold
}
