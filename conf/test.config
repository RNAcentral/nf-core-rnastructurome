/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Human subset test dataset to check pipeline function'

    // Input — build a temp samplesheet with absolute paths substituted in
    input        = {
        def src = new File(projectDir.toString(), 'tests/data/rnastruct00001_samplesheet.first2.trim_top1.csv')
        def tmp = File.createTempFile('rnastructurome-test-', '.csv')
        tmp.text = src.text.replace('tests/data/', "${src.parentFile.absolutePath}/")
        tmp.absolutePath
    }.call()
    principle     = 'RT-stop'
    transcriptome = true  // test uses a transcript-level FASTA; selects Bowtie route
    fasta         = "${projectDir}/tests/data/Homo_sapiens.GRCh38.ENST00000389680.fa"
    rfnorm_raw   = true  // skip normalisation so rf-fold still runs on tiny test data
    rfnorm_nan   = 1     // disable NaN masking; test reads are too few to meet the default threshold
}
