/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Uses the human mitochondrial chromosome (16,569 bp) as the reference genome so
    that the full STAR genome-alignment route is exercised on tiny local data.
    Test reads are from ENST00000389680 (MT-RNR1, MT:648-1601).

    Reference files can be regenerated with:
        python3 tmp/download_mt_star_test_data.py

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // MT chromosome is 16,569 bp; STAR needs a reduced SA index for small genomes.
    // Formula: floor(log2(genomeLength) / 2) - 1 = floor(14.01 / 2) - 1 = 6
    withName: 'STAR_GENOMEGENERATE' {
        ext.args = '--genomeSAindexNbases 6'
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Human mitochondrial chromosome test dataset to check pipeline function (STAR route)'

    // Input — synthetic reads from the MT RNR1 region, guaranteed to map to the MT genome.
    // Regenerate with: python3 tmp/generate_mt_test_reads.py
    input        = "${projectDir}/tests/data/rnastruct00001_samplesheet.star_test.csv"

    principle    = 'RT-stop'
    fasta        = "${projectDir}/testdata/Homo_sapiens.GRCh38.MT.fa"
    gtf          = "${projectDir}/testdata/Homo_sapiens.GRCh38.MT.gtf"
    rfnorm_raw   = true  // skip normalisation so rf-fold still runs on tiny test data
    rfnorm_nan   = 0     // disable NaN masking; test reads are too few to meet the default threshold
}
