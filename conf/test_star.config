/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal STAR-route tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Tests the genome-alignment path (STAR + rf-count-genome + rf-rctools extract)
    using the human mitochondrial chromosome (16,569 bp) as a minimal genome.

    The test reads are from ENST00000389680 (MT-RNR1, MT:648-1601) so they map
    directly to this genome.

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test_star,conda --outdir <OUTDIR>

    Test data can be regenerated with:
        python3 tmp/download_mt_star_test_data.py
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // The MT chromosome is 16,569 bp; STAR requires a reduced SA index for small genomes.
    // Minimum: floor(log2(16569) / 2) - 1 = 6
    withName: 'STAR_GENOMEGENERATE' {
        ext.args = '--genomeSAindexNbases 6'
    }
}

params {
    config_profile_name        = 'Test STAR profile'
    config_profile_description = 'Human mitochondrial chromosome test dataset for the STAR genome-alignment route'

    input        = {
        def src = new File(projectDir.toString(), 'tests/data/rnastruct00001_samplesheet.first2.trim_top1.csv')
        def tmp = File.createTempFile('rnastructurome-test-', '.csv')
        tmp.text = src.text.replace('tests/data/', "${src.parentFile.absolutePath}/")
        tmp.absolutePath
    }.call()

    principle    = 'RT-stop'
    // No --transcriptome flag → STAR genome route
    fasta        = "${projectDir}/testdata/Homo_sapiens.GRCh38.MT.fa"
    gtf          = "${projectDir}/testdata/Homo_sapiens.GRCh38.MT.gtf"
    rfnorm_raw   = true
    rfnorm_nan   = 0
}
