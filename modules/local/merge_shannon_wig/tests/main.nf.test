nextflow_process {

    name "Test Process MERGE_SHANNON_WIG"
    script "../main.nf"
    process "MERGE_SHANNON_WIG"

    tag "modules"
    tag "modules_local"
    tag "merge_shannon_wig"
    config "./nextflow.config"

    test("merge Shannon entropy wiggle files and derive chrom sizes") {

        when {
            params {
                module_prefix = 'group1'
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'group1' ],
                    [
                        file("${projectDir}/modules/local/merge_shannon_wig/tests/fixtures/TX1.wig", checkIfExists: true),
                        file("${projectDir}/modules/local/merge_shannon_wig/tests/fixtures/TX2.wig", checkIfExists: true)
                    ],
                    [
                        file("${projectDir}/modules/local/merge_shannon_wig/tests/fixtures/TX1.xml", checkIfExists: true),
                        file("${projectDir}/modules/local/merge_shannon_wig/tests/fixtures/TX2.xml", checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.merged_wig.size() == 1 },
                { assert process.out.chrom_sizes.size() == 1 },
                {
                    def mergedText = path(process.out.merged_wig[0][1]).text
                    assert mergedText.readLines() == [
                        'track type=wiggle_0',
                        'fixedStep chrom=TX1 start=1 step=1',
                        '0.693',
                        '1.386',
                        'variableStep chrom=TX2',
                        '1 1.099'
                    ]
                },
                {
                    def sizesText = path(process.out.chrom_sizes[0][1]).text
                    assert sizesText.readLines() == [
                        'TX1\t10',
                        'TX2\t20'
                    ]
                }
            )
        }
    }

    test("merge Shannon entropy wiggle files - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'group1' ],
                    file("${projectDir}/modules/local/merge_shannon_wig/tests/fixtures/TX1.wig", checkIfExists: true),
                    file("${projectDir}/modules/local/merge_shannon_wig/tests/fixtures/TX1.xml", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.merged_wig.size() == 1 },
                { assert process.out.chrom_sizes.size() == 1 }
            )
        }
    }
}
