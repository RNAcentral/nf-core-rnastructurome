nextflow_process {

    name "Test Process RNAFRAMEWORK_RFEVAL"
    script "../main.nf"
    process "RNAFRAMEWORK_RFEVAL"

    tag "modules"
    tag "modules_local"
    tag "rnaframework"
    tag "rnaframework/eval"
    config "./nextflow.config"

    test("rfeval - stub single xml") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'group1' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/rnaframework/eval/tests/fixtures/test_structures.db", checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.csv.size() == 1 },
                { assert path(process.out.csv[0][1]).text.contains('AUROC') },
                { assert path(process.out.csv[0][1]).text.contains('DSCI') },
                { assert process.out.log.size() == 1 },
                { assert process.out.plots.size() == 0 },
                { assert process.out.windows.size() == 0 }
            )
        }
    }

    test("rfeval - stub with windows manifest") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'group_windows' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/rnaframework/eval/tests/fixtures/test_structures.db", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/rnaframework/eval/tests/fixtures/test_windows.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.csv.size() == 1 },
                { assert process.out.windows.size() == 1 },
                // versions.yml must stay valid YAML — a failed probe reports 'unknown',
                // it never leaks a shell error message onto the line
                { assert path(process.out.versions[0]).yaml['RNAFRAMEWORK_RFEVAL'].containsKey('python') },
                { assert !path(process.out.versions[0]).text.contains('command not found') }
            )
        }
    }

    test("rfeval - stub multiple xmls") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'group_multi' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                    ]
                ])
                input[1] = file("${projectDir}/modules/local/rnaframework/eval/tests/fixtures/test_structures.db", checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.csv.size() == 1 },
                { assert path(process.out.csv[0][1]).text.contains('unpaired_coeff') },
                { assert process.out.log.size() == 1 }
            )
        }
    }

    test("rfeval - stub with plots") {

        options "-stub"

        when {
            params {
                module_args = '-g'
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'group_plots' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/rnaframework/eval/tests/fixtures/test_structures.db", checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.csv.size() == 1 },
                { assert process.out.log.size() == 1 }
            )
        }
    }

    test("rfeval - stub with reactivity cutoff") {

        options "-stub"

        when {
            params {
                module_args = '-c 0.5'
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'group_cutoff' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                input[1] = file("${projectDir}/modules/local/rnaframework/eval/tests/fixtures/test_structures.db", checkIfExists: true)
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.csv.size() == 1 }
            )
        }
    }
}
