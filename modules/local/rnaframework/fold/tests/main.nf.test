nextflow_process {

    name "Test Process RNAFRAMEWORK_RFFOLD"
    script "../main.nf"
    process "RNAFRAMEWORK_RFFOLD"

    tag "modules"
    tag "modules_local"
    tag "rnaframework"
    tag "rnaframework/fold"
    config "./nextflow.config"

    test("rffold - stub") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'group1' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.structures.size() == 1 }
            )
        }
    }
}
