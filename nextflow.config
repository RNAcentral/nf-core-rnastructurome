/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/rnastructurome Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    sample_id                  = null
    method                     = null
    principle                  = null
    organism                   = null
    fasta                      = null
    gtf                        = null
    genomes                    = null
    cutadapt_adapter_5p        = null
    cutadapt_adapter_3p        = null
    cutadapt_quality_only      = false
    cutadapt_5quality          = 20
    cutadapt_3quality          = 20
    cutadapt_len               = 25
    cutadapt_min_align         = 10
    cutadapt_trim_n            = true
    umi_pattern                = null

    // Alignment options (Bowtie/Bowtie2)
    bowtie_mapping_params      = null
    bowtie_manual_only         = false
    bowtie_k                   = 1
    bowtie_all                 = false
    bowtie_norc                = false
    bowtie_trim5               = 0
    bowtie_trim3               = 0
    bowtie_index               = null
    bowtie_seedlen             = null
    bowtie_n                   = 2
    bowtie_v                   = null
    bowtie_max                 = 1
    bowtie_chunkmbs            = 512
    bowtie2_N                  = 0
    bowtie2_D                  = 15
    bowtie2_R                  = 2
    bowtie2_mp                 = '6,2'
    bowtie2_dpad               = 15
    bowtie2_rdg                = '5,3'
    bowtie2_rfg                = '5,3'
    bowtie2_softclip           = false
    bowtie2_ma                 = 2
    bowtie2_dovetail           = false

    // RNAframework rf-count options
    rfcount_img                = true
    rfcount_trim_5prime        = 0
    rfcount_mask_file          = null
    rfcount_primary_only       = false
    rfcount_paired_only        = false
    rfcount_properly_paired    = false
    rfcount_map_sort_by_read_name = false
    rfcount_map_discard_shorter   = 1
    rfcount_map_min_quality       = 20
    rfcount_map_collapse_consecutive = true
    rfcount_map_max_collapse_distance = 2

    // RNAframework rf-norm options
    rfnorm_remap_reactivities   = false
    rfnorm_reactive_bases       = null
    rfnorm_norm_window          = null
    rfnorm_window_offset        = null
    rfnorm_dynamic_window       = null
    rfnorm_norm_independent     = false
    rfnorm_norm_factor          = null
    rfnorm_norm_method          = null
    rfnorm_raw                  = false
    rfnorm_pseudocount          = null
    rfnorm_max_score            = null
    rfnorm_ignore_lower_than_untreated = false
    rfnorm_max_untreated_mut    = null
    rfnorm_max_mutation_rate    = null
    rfnorm_mean_coverage        = 10
    rfnorm_median_coverage      = 0
    rfnorm_nan                  = 10
    rfnorm_img                  = true

    // RNAframework rf-fold options
    vienna_structures                 = false
    rffold_ct                  = false
    rffold_window              = true
    rffold_unconstrained       = false
    rffold_vienna_no_lonely_pairs = false
    rffold_vienna_constrained  = false
    rffold_vienna_max_bp_span  = null
    rffold_vienna_bp_span      = null
    rffold_only_common         = null
    rffold_fold_constraint_file = null
    rffold_unpaired_constraint_file = null
    rffold_dotplot             = true
    rffold_shannon_entropy     = true
    rffold_vienna_rnaplot      = 'RNAplot'
    r2dt                       = true
    rfwiggle_report_zeroes     = true // report 0 instead of null for bases with no coverage as this is expected by genome browsers
    rfwiggle_keep_bases        = null
    rnaframework_container     = 'ghcr.io/vicbeg/rnaframework:2.9.6-r5-runtime'
    rnaframework_r_path        = '/usr/bin/R'

    // References
    ensembl_base_url           = 'https://ftp.ensembl.org/pub'
    ensembl_release            = 'current'
    ensembl_species_map        = [
        'human'   : 'homo_sapiens',
        'mouse'   : 'mus_musculus',
        'yeast'   : 'saccharomyces_cerevisiae',
        'rat'     : 'rattus_norvegicus'
    ]
    ncbi_accessions_map        = [:]

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = System.getenv('HOOK_URL')
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Curated NCBI accession lists for viral organisms — loaded automatically
includeConfig 'conf/viral_genomes.config'

profiles {
    debug {
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
        // On macOS arm64, force osx-64 packages (run under Rosetta 2) so that
        // bioconda tools like rnaframework resolve correctly. conda.createOptions
        // passes --platform directly to `conda create`, avoiding the need to
        // export CONDA_SUBDIR=osx-64 manually before running.
        conda.createOptions     = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '--platform osx-64' : ''
        env.CONDA_SUBDIR        = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? 'osx-64' : null
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
        }
        process {
            resourceLimits = [
                cpus: 4,
                memory: '15.GB',
                time: '1.h'
            ]
            withName: 'CAT_FASTQ' {
                // lbzip2 is Linux-only; use an inline spec without it on macOS
                conda = System.getProperty('os.name')?.contains('Mac') ? 'conda-forge::coreutils=9.5 conda-forge::grep=3.11 conda-forge::gzip=1.13 conda-forge::sed=4.8 conda-forge::tar=1.34' : null
            }
            // On macOS arm64 switch from YAML-based to inline conda specs so that
            // conda.createOptions (--platform osx-64) is actually honoured.
            // conda env create (YAML) ignores createOptions; conda create (inline) does not.
            // All rnaframework processes also get beforeScript to ensure the conda env's
            // Perl takes precedence over any system Perl earlier in the user's PATH
            // (e.g. from perlbrew / local::lib), which would lack the right XS modules.
            withName: 'RNAFRAMEWORK_RFCOUNT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFNORM' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFFOLD' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6 bioconda::viennarna=2.7.2 conda-forge::perl' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFWIGGLE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6 bioconda::ucsc-bedgraphtobigwig' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
        }
    }
    mamba {
        // Users running this profile need `mamba` installed and available on PATH.
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        conda.createOptions     = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '--platform osx-64' : ''
        env.CONDA_SUBDIR        = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? 'osx-64' : null
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
        }
        process {
            resourceLimits = [
                cpus: 4,
                memory: '15.GB',
                time: '1.h'
            ]
            withName: 'CAT_FASTQ' {
                // lbzip2 is Linux-only; use an inline spec without it on macOS
                conda = System.getProperty('os.name')?.contains('Mac') ? 'conda-forge::coreutils=9.5 conda-forge::grep=3.11 conda-forge::gzip=1.13 conda-forge::sed=4.8 conda-forge::tar=1.34' : null
            }
            // On macOS arm64 switch from YAML-based to inline conda specs so that
            // conda.createOptions (--platform osx-64) is actually honoured.
            // conda env create (YAML) ignores createOptions; conda create (inline) does not.
            // All rnaframework processes also get beforeScript to ensure the conda env's
            // Perl takes precedence over any system Perl earlier in the user's PATH
            // (e.g. from perlbrew / local::lib), which would lack the right XS modules.
            withName: 'RNAFRAMEWORK_RFCOUNT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFNORM' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFFOLD' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6 bioconda::viennarna=2.7.2 conda-forge::perl' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFWIGGLE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.6 bioconda::ucsc-bedgraphtobigwig' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
        }
    }
    docker {
        docker.enabled          = true
        conda.enabled           = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '-u $(id -u):$(id -g) --platform linux/amd64' : '-u $(id -u):$(id -g)'
        process.arch            = null
        apptainer.ociAutoPull   = false
        singularity.ociAutoPull = false
        wave.enabled            = false
        wave.freeze             = false
        wave.strategy           = null
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
        }
        process {
            withName: '.*' {
                // Disable conda for all processes so Docker is always used.
                // conda.enabled is still true on ARM64 to allow the MULTIQC exception below.
                conda = null
            }
            withName: '(^|.*:)MULTIQC$' {
                // MultiQC segfaults under Docker/qemu on Apple Silicon; run from conda instead.
                container        = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? null : null
                containerOptions = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? null : null
                conda            = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? "${projectDir}/modules/nf-core/multiqc/environment.yml" : null
            }
        }
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
        }
        process {
            withName: '(^|.*:)FASTQC_PRE$' {
                cpus   = 6
                memory = 36.GB
                time   = 8.h
            }
            withName: '(^|.*:)FASTQC_POST$' {
                cpus   = 6
                memory = 36.GB
                time   = 8.h
            }
            withName: 'NFCORE_RNASTRUCTUROME:RNASTRUCTUROME:BOWTIE_ALIGN' {
                cpus       = 24
                memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
                time       = { 16.h * task.attempt }
                maxRetries = 2
            }
            withName: 'NFCORE_RNASTRUCTUROME:RNASTRUCTUROME:BOWTIE2_ALIGN' {
                cpus       = 24
                memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
                time       = { 16.h * task.attempt }
                maxRetries = 2
            }
            withName: '(^|.*:)RNAFRAMEWORK_RFCOUNT$' {
                cpus = 100
                time = 24.h
            }
            withName: '(^|.*:)RNAFRAMEWORK_RFNORM$' {
                cpus = 30
                time = 24.h
            }
            withName: '(^|.*:)RNAFRAMEWORK_RFFOLD$' {
                cpus = 100
                time = 24.h
            }
            withName: '(^|.*:)AVERAGE_WIG$' {
                memory = { 32.GB * task.attempt }
                time   = { 4.h  * task.attempt }
            }
            withName: '(^|.*:)SAMTOOLS_MARKDUP$' {
                cpus       = 12
                memory     = { 64.GB * task.attempt }
                maxRetries = 2
            }
            withName: '(^|.*:)MERGE_BP$' {
                memory = { 32.GB * task.attempt }
                time   = { 4.h   * task.attempt }
            }
            withName: '(^|.*:)R2DT$' {
                memory = { 64.GB * task.attempt }
                time   = { 8.h   * task.attempt }
            }
        }
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }

    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }

    codon {
        executor {
            name            = 'slurm'
            queueSize       = 2000       // max jobs submitted to SLURM at once
            submitRateLimit = '1sec'
            exitReadTimeout = '30 min'
        }
        process {
            queue = 'production'
        }
    }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/rnastructurome custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load nf-core/rnastructurome custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/rnastructurome.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
    overwrite = true
}

    manifest {
        name            = 'nf-core/rnastructurome'
        contributors    = [
            [
                name: 'Victoria Begley',
                affiliation: 'EMBL-EBI',
                email: 'begley@ebi.ac.uk',
                github: 'github.com/RNAcentral',
                contribution: ['author'],
                orcid: ''
            ] // Add more contributors here as needed
        ]
    homePage        = 'https://github.com/nf-core/rnastructurome'
    description     = """This pipeline analyses chemical-based high-throughput RNA structure probing data"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=26.04.0'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
