nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                def untreated_fastq = new File("${projectDir}/tests/data/GSM4333255.R1.HEK293T_untreated_r1.trim.subset.fastq.gz").absolutePath
                def treated_fastq = new File("${projectDir}/tests/data/GSM4333256.R1.HEK293T_treated_r1.trim.subset.fastq.gz").absolutePath
                def samplesheet = new File("$outputDir/rnastruct00001_samplesheet.first2.trim_subset_top3.csv")
                samplesheet.text = '''sample,sample_id,fastq_1,fastq_2,method,principle,cell_line,condition,replicate,organism,adapter_3p,adapter_5p,umi_pattern
HEK293T_untreated_r1,GSM4333255,''' + untreated_fastq + ''',,SHAPE,RT-stop,HEK293T,untreated,1,Homo sapiens,,,
HEK293T_treated_r1,GSM4333256,''' + treated_fastq + ''',,SHAPE,RT-stop,HEK293T,treated,1,Homo sapiens,,,
'''
                outdir = "$outputDir"
                input = samplesheet.toString()
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/pipeline_info/nf_core_rnastructurome_software_mqc_versions.yml").exists() },
                { assert path("$outputDir/multiqc/multiqc_report.html").exists() }
            )
        }
    }
}
