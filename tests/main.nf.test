nextflow_workflow {

    name "Test Main Workflow NFCORE_RNASTRUCTUROME"
    script "../main.nf"
    config "${new File('tests/nextflow.config').absolutePath}"
    workflow "NFCORE_RNASTRUCTUROME"
    tag "main"
    tag "workflows"
    tag "nfcore_rnastructurome"

    test("Runs the named workflow with a minimal RT-stop sample") {

        options "-stub"

        when {
            workflow {
                """
                params.outdir = "$outputDir"
                params.fasta  = file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.ENST00000389680.fa", checkIfExists: true).toString()
                params.gtf    = file("\${projectDir}/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz", checkIfExists: true).toString()

                input[0] = Channel.of(
                    [
                        [ id:'main_rtstop', sample_id:'main_rtstop', principle:'RT-stop', organism:'Homo sapiens', single_end:true, sample_group:'main_line', replicate:'rep1', condition:'treated' ],
                        [ file("\${projectDir}/tests/data/GSM4333255.R1.HEK293T_untreated_r1.trim.top1.fastq.gz", checkIfExists: true) ]
                    ]
                )
                input[1] = [
                    outdir: "$outputDir",
                    fasta : file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.ENST00000389680.fa", checkIfExists: true).toString(),
                    gtf   : file("\${projectDir}/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz", checkIfExists: true).toString()
                ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(path("${outputDir}/pipeline_info/nf_core_rnastructurome_software_mqc_versions.yml")).match() }
            )
        }
    }

    test("Runs with cross-experiment rf-normfactor normalisation enabled") {

        options "-stub"

        when {
            workflow {
                """
                params.outdir                = "$outputDir"
                params.fasta                 = file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.ENST00000389680.fa", checkIfExists: true).toString()
                params.gtf                   = file("\${projectDir}/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz", checkIfExists: true).toString()
                params.rfnorm_use_normfactor = true

                input[0] = Channel.of(
                    [
                        [ id:'main_rtstop', sample_id:'main_rtstop', principle:'RT-stop', organism:'Homo sapiens', single_end:true, sample_group:'main_line', replicate:'rep1', condition:'treated' ],
                        [ file("\${projectDir}/tests/data/GSM4333255.R1.HEK293T_untreated_r1.trim.top1.fastq.gz", checkIfExists: true) ]
                    ]
                )
                input[1] = [
                    outdir                : "$outputDir",
                    fasta                 : file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.ENST00000389680.fa", checkIfExists: true).toString(),
                    gtf                   : file("\${projectDir}/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz", checkIfExists: true).toString(),
                    rfnorm_use_normfactor : true
                ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // rf-normfactor only runs when --rfnorm_use_normfactor is set; its presence in the
                // collated versions confirms the cross-experiment branch executed.
                { assert path("${outputDir}/pipeline_info/nf_core_rnastructurome_software_mqc_versions.yml").text.contains('RNAFRAMEWORK_RFNORMFACTOR') }
            )
        }
    }

    test("Runs with rf-structextract motif extraction enabled") {

        options "-stub"

        when {
            workflow {
                """
                params.outdir        = "$outputDir"
                params.fasta         = file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.ENST00000389680.fa", checkIfExists: true).toString()
                params.gtf           = file("\${projectDir}/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz", checkIfExists: true).toString()
                params.structextract = true

                input[0] = Channel.of(
                    [
                        [ id:'main_rtstop', sample_id:'main_rtstop', principle:'RT-stop', organism:'Homo sapiens', single_end:true, sample_group:'main_line', replicate:'rep1', condition:'treated' ],
                        [ file("\${projectDir}/tests/data/GSM4333255.R1.HEK293T_untreated_r1.trim.top1.fastq.gz", checkIfExists: true) ]
                    ]
                )
                input[1] = [
                    outdir        : "$outputDir",
                    fasta         : file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.ENST00000389680.fa", checkIfExists: true).toString(),
                    gtf           : file("\${projectDir}/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz", checkIfExists: true).toString(),
                    structextract : true
                ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // rf-structextract only runs when --structextract is set; its presence in the
                // collated versions confirms the motif-extraction branch executed.
                { assert path("${outputDir}/pipeline_info/nf_core_rnastructurome_software_mqc_versions.yml").text.contains('RNAFRAMEWORK_RFSTRUCTEXTRACT') }
            )
        }
    }
}
