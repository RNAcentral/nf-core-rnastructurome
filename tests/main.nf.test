nextflow_workflow {

    name "Test Main Workflow NFCORE_RNASTRUCTUROME"
    script "../main.nf"
    config "${new File('tests/nextflow.config').absolutePath}"
    workflow "NFCORE_RNASTRUCTUROME"
    tag "main"
    tag "workflows"
    tag "nfcore_rnastructurome"

    test("Runs the named workflow with a minimal RT-stop sample") {

        options "-stub"

        when {
            workflow {
                """
                params.outdir = "$outputDir"
                params.fasta  = file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.selected_top3_subset.fa", checkIfExists: true).toString()

                input[0] = Channel.of(
                    [
                        [ id:'main_rtstop', sample_id:'main_rtstop', principle:'RT-stop', organism:'Homo sapiens', single_end:true, cell_line:'main_line', replicate:'rep1', condition:'treated' ],
                        [ file("\${projectDir}/tests/data/GSM4333255.R1.HEK293T_untreated_r1.trim.subset.fastq.gz", checkIfExists: true) ]
                    ]
                )
                input[1] = [
                    outdir: "$outputDir",
                    fasta : file("\${projectDir}/tests/data/Homo_sapiens.GRCh38.selected_top3_subset.fa", checkIfExists: true).toString()
                ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }
}
